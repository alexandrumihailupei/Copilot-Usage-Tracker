{
  "name": "copilot-usage-tracker",
  "displayName": "AI Usage Tracker",
  "description": "Analyze AI coding-assistant token usage, session statistics, and workflow-efficiency insights from local logs (GitHub Copilot and Claude Code).",
  "version": "0.2.7",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/local/copilot-usage-tracker"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotUsageTracker.openDashboard",
        "title": "Open AI Usage Dashboard",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.refresh",
        "title": "Refresh Usage Data",
        "category": "AI Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotUsageTracker.toggleProvider",
        "title": "Switch Provider (Copilot / Claude)",
        "category": "AI Usage",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "copilotUsageTracker.addLogDirectory",
        "title": "Add Log Directory",
        "category": "AI Usage",
        "icon": "$(add)"
      },
      {
        "command": "copilotUsageTracker.selectIdeSources",
        "title": "Select IDE Sources (GitHub Copilot)",
        "category": "AI Usage",
        "icon": "$(device-desktop)"
      },
      {
        "command": "copilotUsageTracker.clearCache",
        "title": "Clear Cache",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.openRawLog",
        "title": "Open Raw Log",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.stats.prevMonth",
        "title": "Previous Month (older)",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.stats.nextMonth",
        "title": "Next Month (newer)",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.stats.allTime",
        "title": "All Time Stats",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.stats.currentMonth",
        "title": "Current Month Stats",
        "category": "AI Usage"
      },
      {
        "command": "copilotUsageTracker.stats.selectMonth",
        "title": "Select Billing Period",
        "category": "AI Usage"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotUsageTracker",
          "title": "AI Usage",
          "icon": "media/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "copilotUsageTracker": [
        {
          "id": "copilotUsageTracker.sessions",
          "name": "Sessions"
        },
        {
          "id": "copilotUsageTracker.quickStats",
          "name": "Quick Stats"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotUsageTracker.toggleProvider",
          "when": "view == copilotUsageTracker.sessions",
          "group": "navigation@1"
        },
        {
          "command": "copilotUsageTracker.refresh",
          "when": "view == copilotUsageTracker.sessions",
          "group": "navigation@2"
        },
        {
          "command": "copilotUsageTracker.addLogDirectory",
          "when": "view == copilotUsageTracker.sessions",
          "group": "navigation@3"
        },
        {
          "command": "copilotUsageTracker.selectIdeSources",
          "when": "view == copilotUsageTracker.sessions",
          "group": "navigation@4"
        },
        {
          "command": "copilotUsageTracker.toggleProvider",
          "when": "view == copilotUsageTracker.quickStats",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "copilotUsageTracker.openRawLog",
          "when": "view == copilotUsageTracker.sessions && viewItem == session"
        }
      ]
    },
    "configuration": {
      "title": "AI Usage Tracker",
      "properties": {
        "copilotUsageTracker.logDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional directories to scan for Copilot Chat debug-logs."
        },
        "copilotUsageTracker.autoScanWorkspaceStorage": {
          "type": "boolean",
          "default": true,
          "description": "Auto-discover logs across all VS Code-family editors (Code, Insiders, VSCodium, Cursor, Windsurf, ...) plus a best-effort JetBrains probe."
        },
        "copilotUsageTracker.enabledEditors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "IDE editor keys to include when auto-scanning GitHub Copilot logs (e.g. \"Code\", \"Cursor\", \"JetBrains\"). Empty = all detected. Manage via the \"Select IDE Sources\" button."
        },
        "copilotUsageTracker.parseSubagentLogs": {
          "type": "boolean",
          "default": true,
          "description": "Recursively parse subagent JSONL files for full token accounting."
        },
        "copilotUsageTracker.defaultGroupBy": {
          "type": "string",
          "enum": [
            "date",
            "workspace",
            "model"
          ],
          "default": "date",
          "description": "Default session grouping in the sidebar."
        },
        "copilotUsageTracker.plan": {
          "type": "string",
          "enum": [
            "free",
            "pro",
            "pro+",
            "business",
            "enterprise"
          ],
          "default": "business",
          "description": "Your GitHub Copilot plan (determines monthly quota for billing display)."
        },
        "copilotUsageTracker.claudeProjectsDirectory": {
          "type": "string",
          "default": "~/.claude/projects",
          "description": "Root directory containing Claude Code transcripts (one <sessionId>.jsonl per session)."
        },
        "copilotUsageTracker.claudeCostBasis": {
          "type": "string",
          "enum": [
            "api",
            "subscription"
          ],
          "default": "api",
          "description": "How to present Claude cost: 'api' = USD at Anthropic list prices; 'subscription' = API-equivalent (included in your Claude plan)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./test/run-unit-tests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  }
}
